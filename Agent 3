    The more context we give Claude, the better the report.
    """

    momentum_str = json.dumps(momentum_top, indent=2) if momentum_top else "No momentum setups this week."
    bounce_str   = json.dumps(bounce_top,   indent=2) if bounce_top   else "No bounce setups this week."
    overlap_str  = ", ".join(overlap) if overlap else "None this week."

    market_str = ""
    for label, data in market_context.items():
        market_str += (
            f"  {label}: ${data['price']} | "
            f"Daily: {data['daily_chg']}% | "
            f"Weekly: {data['weekly_chg']}%\n"
        )

    prompt = f"""
