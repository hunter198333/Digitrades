def run_report():
    """
    Main entry point for Agent 3.
    Reads Agent 1 + Agent 2 data, synthesizes, and generates
    the weekly report using Claude.
    """
    today      = datetime.today()
    week_label = f"Week of {(today - timedelta(days=today.weekday())).strftime('%B %d, %Y')}"

    log.info("=" * 55)
    log.info("  AGENT 3 — WEEKLY REPORT GENERATOR STARTING")
    log.info(f"  {today.strftime('%Y-%m-%d %H:%M:%S ET')}")
    log.info(f"  {week_label}")
    log.info("=" * 55)

    # 1. Read this week's scan data from both agents
    log.info("Reading Agent 1 data from Google Sheets...")
    momentum_data = read_sheet_this_week("A1_Momentum_Scan")

    log.info("Reading Agent 2 data from Google Sheets...")
    bounce_data = read_sheet_this_week("A2_Bounce_Scan")

    if not momentum_data and not bounce_data:
        log.warning("No data found from either agent this week.")
        log.warning("Make sure Agent 1 and Agent 2 have run at least once this week.")

    # 2. Get top pick