MONDAY_API_URL = "https://api.monday.com/v2"


def post_report_to_monday(report: str, week_label: str, summary: dict):
    """
    Create a new item on the Agent 3 monday.com board with the weekly report.
    """
    # Truncate report for column value (monday has char limits)
    report_preview = report[:2000] + "..." if len(report) > 2000 else report
    report_preview = report_preview.replace('"', '\\"').replace("\n", "\\n")

    col_values = {
        "numbers_momentum":  str(summary.get("momentum_count", 0)),
        "numbers_bounce":    str(summary.get("bounce_count", 0)),
        "numbers_overlap":   str(summary.get("overlap_count", 0)),
        "status_report":     {"label": "Ready"},
        "status_bias":       {"label": summary.get("market_bias", "Neutral")},
        "date_generated":    {"date": datetime.today().strftime("%Y-%m-%d")},
        "long_text_report":  report_preview,
    }

    col_values_str = json.dumps(col_values).replace('"', '\\"')

    query = f"""
    mutation {{
      create_item (
        board_id: {MONDAY_BOARD_ID},
        item_name: "Weekly Report — {week_label}",
        column_values: "{col_values_str}"
      ) {{
        id
      }}
    }}
    """

    headers = {
        "Authorization": MONDAY_API_KEY,
        "Content-Type":  "application/json",
        "API-Version":   "2024-01",
    }

    try:
        resp = requests.post(
            MONDAY_API_URL,
            json={"query": query},
            headers=headers,
            timeout=10
        )
        data = resp.json()
        if "errors" in data:
            log.error(f"monday.com error: {data['errors']}")
        else:
            item_id = data["data"]["create_item"]["id"]
            log.info(f"✅ Report posted to monday.com (ID: {item_id})")
    except Exception as e:
        log.error(f"monday.com post failed: {e}")


def save_report_to_file(report: str, week_label: str):
    """
    Also save the report as a local .txt file for easy reading.
    Creates a 'reports' subfolder in your project directory.
    """
    try:
        os.makedirs("reports", exist_ok=True)
        filename = f"reports/weekly_report_{week_label.replace(' ', '_')}.txt"
        with open(filename, "w", encoding="utf-8") as f:
            f.write(report)
        log.info(f"✅ Report saved locally to {filename}")
    except Exception as e:
        log.warning(f"Could not save report to file: {e}")


