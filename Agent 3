# ─────────────────────────────────────────────
#  STEP 6: CALL CLAUDE API TO WRITE THE REPORT
# ─────────────────────────────────────────────

def generate_report_with_claude(prompt: str) -> str:
    """
    Send the data package to Claude and get back the written report.
    Uses the Anthropic Python SDK.
    """
    log.info("Sending data to Claude API to generate report...")

    try:
        client  = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)

        message = client.messages.create(
            model      = "claude-opus-4-6",        # Best model for synthesis + writing
            max_tokens = 4096,
            messages   = [
                {
                    "role":    "user",
                    "content": prompt
                }
            ]
        )

        report = message.content[0].text
        log.info("✅ Claude generated the weekly report successfully.")
        return report

    except Exception as e:
        log.error(f"Claude API call failed: {e}")
        # Return a fallback plain report if API fails
        return f"[Claude API unavailable — raw data below]\n\n{prompt}"


# ─────────────────────────────────────────────
#  STEP 7: SAVE REPORT TO GOOGLE SHEETS
# ─────────────────────────────────────────────

def save_report_to_sheets(report: str, week_label: str, summary: dict):
    """
    Save the generated report to the A3_Weekly_Reports sheet.
    One row per week — stores the full report text plus key stats.
    """
    try:
        client = get_sheets_client()
        book   = client.open(GOOGLE_SHEET_NAME)

        try:
            sheet = book.worksheet("A3_Weekly_Reports")
        except gspread.WorksheetNotFound:
            sheet = book.add_worksheet("A3_Weekly_Reports", rows=500, cols=10)
            sheet.append_row([
                "Week", "Generated At",
                "Momentum Setups", "Bounce Setups", "Overlap Tickers",
                "Market Bias", "Full Report"
            ])

        sheet.append_row([
            week_label,
            datetime.now().strftime("%Y-%m-%d %H:%M"),
            summary.get("momentum_count", 0),
            summary.get("bounce_count", 0),
            summary.get("overlap_count", 0),
            summary.get("market_bias", "Neutral"),
            report,
        ])

        log.info("✅ Report saved to Google Sheets (A3_Weekly_Reports).")

    except Exception as e:
        log.error(f"Failed to save report to Sheets: {e}")


