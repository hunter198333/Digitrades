# ─────────────────────────────────────────────
#  STEP 1: READ DATA FROM GOOGLE SHEETS
#  Pull this week's results from both Agent 1
#  and Agent 2 sheets.
# ─────────────────────────────────────────────

def get_sheets_client():
    scopes = [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive",
    ]
    creds  = Credentials.from_service_account_file(GOOGLE_CREDS_FILE, scopes=scopes)
    return gspread.authorize(creds)


def read_sheet_this_week(worksheet_name: str) -> list:
    """
    Read all rows from the given worksheet that were added this week.
    Returns a list of dicts (one per row).
    """
    try:
        client    = get_sheets_client()
        book      = client.open(GOOGLE_SHEET_NAME)
        sheet     = book.worksheet(worksheet_name)
        all_rows  = sheet.get_all_records()  # Returns list of dicts using header row

        # Filter to this week only (Monday to today)
        today     = datetime.today()
        week_start = today - timedelta(days=today.weekday())  # Monday
        week_start = week_start.replace(hour=0, minute=0, second=0)

        this_week = []
        for row in all_rows:
            try:
                row_date = datetime.strptime(row.get("Date", ""), "%Y-%m-%d")
                if row_date >= week_start:
                    this_week.append(row)
            except ValueError:
                continue

        log.info(f"Read {len(this_week)} rows from {worksheet_name} (this week)")
        return this_week

    except gspread.WorksheetNotFound:
        log.warning(f"Worksheet '{worksheet_name}' not found — has Agent 1/2 run yet?")
        return []
    except Exception as e:
        log.error(f"Failed to read {worksheet_name}: {e}")
        return []


def read_all_time_sheet(worksheet_name: str) -> list:
    """
    Read ALL rows from a sheet for historical win/loss tracking.
    """
    try:
        client   = get_sheets_client()
        book     = client.open(GOOGLE_SHEET_NAME)
        sheet    = book.worksheet(worksheet_name)
        return sheet.get_all_records()
    except Exception as e:
        log.warning(f"Could not read full history from {worksheet_name}: {e}")
        return []


# ─────────────────────────────────────────────
#  STEP 2: FETCH MARKET CONTEXT
#  Pull current market conditions to give
#  Claude context for the report narrative.
# ─────────────────────────────────────────────

def fetch_market_context() -> dict:
    """
    Fetch current SPY, QQQ, and TSX composite performance
    for macro context in the report.
    """
    context  = {}
    tickers  = {
        "SPY":  "S&P 500",
        "QQQ":  "NASDAQ",
        "X:XIU": "TSX (XIU)",
    }

    for ticker, label in tickers.items():
        try:
            end   = datetime.today().strftime("%Y-%m-%d")
            start = (datetime.today() - timedelta(days=10)).strftime("%Y-%m-%d")
            url   = (
                f"https://api.polygon.io/v2/aggs/ticker/{ticker}/range/1/day"
                f"/{start}/{end}?adjusted=true&sort=asc&limit=10&apiKey={POLYGON_API_KEY}"
            )
            resp  = requests.get(url, timeout=10)
            bars  = resp.json().get("results", [])

            if len(bars) >= 2:
                prev_close   = bars[-2]["c"]
                latest_close = bars[-1]["c"]
                week_ago     = bars[0]["c"]
                daily_chg    = round((latest_close - prev_close) / prev_close * 100, 2)
                weekly_chg   = round((latest_close - week_ago) / week_ago * 100, 2)
                context[label] = {
                    "price":      round(latest_close, 2),
                    "daily_chg":  daily_chg,
                    "weekly_chg": weekly_chg,
                }
        except Exception as e:
            log.warning(f"Could not fetch market context for {ticker}: {e}")
            context[label] = {"price": "N/A", "daily_chg": 0, "weekly_chg": 0}

    return context


def fetch_cad_usd_rate() -> float:
    """Fetch current CAD/USD exchange rate from Polygon."""
    try:
        url  = f"https://api.polygon.io/v2/last/forex/CAD/USD?apiKey={POLYGON_API_KEY}"
        resp = requests.get(url, timeout=10)
        rate = resp.json().get("last", {}).get("ask", 0.74)
        return round(rate, 4)
    except Exception:
        return 0.74  # Fallback approximate rate


# ─────────────────────────────────────────────
#  STEP 3: SYNTHESIZE — FIND OVERLAP TICKERS
#  Tickers appearing in BOTH Agent 1 and Agent 2
#  this week are the highest conviction setups.
# ─────────────────────────────────────────────

def find_overlap_tickers(momentum_data: list, bounce_data: list) -> list:
    """
    Find tickers that appear in both Agent 1 and Agent 2 results this week.
    These are the highest conviction setups — oversold AND showing momentum.
    """
    momentum_tickers = set(row.get("Ticker", "") for row in momentum_data)
    bounce_tickers   = set(row.get("Ticker", "") for row in bounce_data)
    overlap          = momentum_tickers.intersection(bounce_tickers)

    if overlap:
        log.info(f"🔥 Overlap tickers found: {overlap}")
    else:
        log.info("No overlap tickers this week.")

    return list(overlap)


def get_top_picks(data: list, n: int = 5) -> list:
    """Sort by Conviction Score and return top N picks."""
    try:
        sorted_data = sorted(
            data,
            key=lambda x: float(x.get("Conviction Score", 0)),
            reverse=True
        )
        return sorted_data[:n]
    except Exception:
        return data[:n]


# ─────────────────────────────────────────────
#  STEP 4: CALCULATE PREVIOUS WEEK PERFORMANCE
#  Basic win/loss tracking from the Trades log.
# ─────────────────────────────────────────────

def calculate_weekly_performance() -> dict:
    """
    Read the trade log sheet and calculate last week's win/loss stats.
    Expects a sheet named 'Trade_Log' with columns:
    Date, Ticker, Entry, Exit, PnL %, Result (Win/Loss)

    If sheet doesn't exist yet, returns placeholder stats.
    """
    try:
        client = get_sheets_client()
        book   = client.open(GOOGLE_SHEET_NAME)
        sheet  = book.worksheet("Trade_Log")
        rows   = sheet.get_all_records()

        # Filter last week
        today      = datetime.today()
        last_week_end   = today - timedelta(days=today.weekday() + 1)
        last_week_start = last_week_end - timedelta(days=6)

        last_week_trades = []
        for row in rows:
            try:
                row_date = datetime.strptime(row.get("Date", ""), "%Y-%m-%d")
                if last_week_start <= row_date <= last_week_end:
                    last_week_trades.append(row)
            except ValueError:
                continue

        if not last_week_trades:
            return {"trades": 0, "winners": 0, "losers": 0, "win_rate": 0,
                    "avg_win": 0, "avg_loss": 0, "notes": "No trades logged last week."}

        winners  = [t for t in last_week_trades if t.get("Result") == "Win"]
        losers   = [t for t in last_week_trades if t.get("Result") == "Loss"]
        avg_win  = round(sum(float(t.get("PnL %", 0)) for t in winners) / len(winners), 2) if winners else 0
        avg_loss = round(sum(float(t.get("PnL %", 0)) for t in losers)  / len(losers),  2) if losers  else 0
        win_rate = round(len(winners) / len(last_week_trades) * 100, 1)

        return {
            "trades":   len(last_week_trades),
            "winners":  len(winners),
            "losers":   len(losers),
            "win_rate": win_rate,
            "avg_win":  avg_win,
            "avg_loss": avg_loss,
            "notes":    "Based on Trade_Log sheet.",
        }

    except gspread.WorksheetNotFound:
        return {
            "trades": 0, "winners": 0, "losers": 0, "win_rate": 0,
            "avg_win": 0, "avg_loss": 0,
            "notes": "Trade_Log sheet not set up yet — add it to track performance."
        }
    except Exception as e:
        log.warning(f"Could not calculate performance: {e}")
        return {"trades": 0, "winners": 0, "losers": 0, "win_rate": 0,
                "avg_win": 0, "avg_loss": 0, "notes": str(e)}


# ─────────────────────────────────────────────
#  STEP 5: BUILD THE DATA PACKAGE FOR CLAUDE
#  Assemble everything into a clean prompt
#  that Claude will use to write the report.
# ─────────────────────────────────────────────

